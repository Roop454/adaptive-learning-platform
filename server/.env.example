# Copy this file to .env and fill in the values.

# MongoDB connection string. For a local server this is usually:
#   mongodb://127.0.0.1:27017/adaptive-learning
# For MongoDB Atlas, paste the SRV string from your cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-learning

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on.
PORT=4000

# Where the React app is served from (used for CORS). Use * only in dev.
CLIENT_ORIGIN=http://localhost:5173
